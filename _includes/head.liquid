<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  {%- if page.title and page.permalink != '/' -%}
    {%- assign page_title = page.title | capitalize | append: ' · ' | append: site.title -%}
  {%- else -%}
    {%- assign page_title = site.title | append: ' — ' | append: site.subtitle -%}
  {%- endif -%}
  <title>{{ page_title }}</title>

  {%- assign desc = page.description | default: site.description | strip_newlines -%}
  <meta name="description" content="{{ desc | strip_html | truncate: 200 }}">
  <meta name="author" content="{{ site.title }}">
  {%- if site.keywords %}<meta name="keywords" content="{{ site.keywords }}">{% endif %}
  <link rel="canonical" href="{{ page.url | absolute_url }}">
  {%- if page.noindex -%}<meta name="robots" content="noindex, nofollow">{%- endif -%}

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ page_title }}">
  <meta property="og:description" content="{{ desc | strip_html | truncate: 200 }}">
  <meta property="og:url" content="{{ page.url | absolute_url }}">
  <meta name="twitter:card" content="summary">

  <!-- Emoji favicon, no image asset needed -->
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>{{ site.icon | default: '📄' }}</text></svg>">

  <!-- Set theme before paint to avoid a flash -->
  <script>
    (function () {
      try {
        var t = localStorage.getItem('theme') || 'dark'; // dark is the default
        if (t === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
      } catch (e) {}
    })();
  </script>

  <!-- Fetch the display font in parallel with the CSS instead of after it -->
  <link rel="preload" href="{{ '/assets/fonts/fraunces-variable.woff2' | relative_url }}" as="font" type="font/woff2" crossorigin>

  <link rel="stylesheet" href="{{ '/assets/css/main.css' | relative_url }}">

  <!-- Instant navigation: the browser fully renders a same-origin page once a
       click looks likely, so switching pages is near-zero-latency. Chromium
       only; other browsers fall back to the hover-prefetch in site.js. -->
  <script type="speculationrules">
    {
      "prerender": [{
        "where": { "href_matches": "/*" },
        "eagerness": "moderate"
      }]
    }
  </script>
  {%- feed_meta -%}
</head>
