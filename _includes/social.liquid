{%- comment -%} Inline-SVG social row from _data/socials.yml {%- endcomment -%}
<div class="socials">
  {%- for s in site.data.socials -%}
    <a href="{{ s.url }}" title="{{ s.name }}" aria-label="{{ s.name }}"
       {% unless s.icon == 'email' %}target="_blank" rel="noopener"{% endunless %}>
      {% include icon.liquid name=s.icon %}
    </a>
  {%- endfor -%}
</div>
