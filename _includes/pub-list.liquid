{%- comment -%}
  Publications from _data/publications.yml, plus disclosures/patents from
  _data/patents.yml. 

  include.selected == true → only `selected: true` entries, flat, no filters.
  Otherwise → filter buttons + year-grouped list.

  Filter bucket is derived from `type`:
    workshop   ← workshop
    abstract   ← poster, abstract
    preprint   ← preprint
    patent     ← patent (all of _data/patents.yml)
    conference ← everything else (full paper, chapter, thesis)

  `status` is display only. It can raise an "Under review" badge.
{%- endcomment -%}
{%- assign pubs = site.data.publications -%}
{%- assign blank_array = "" | split: "," -%}
{%- assign patents = site.data.patents | default: blank_array -%}
{%- assign all = pubs | concat: patents -%}

{%- if include.selected -%}
  <div class="pubs">
    {%- for p in all -%}
      {%- if p.selected -%}{% include pub-item.liquid p=p compact=true %}{%- endif -%}
    {%- endfor -%}
  </div>

{%- else -%}
  {%- comment -%} Count each category so the buttons can show totals. {%- endcomment -%}
  {%- assign n_workshop = 0 -%}
  {%- assign n_abstract = 0 -%}
  {%- assign n_conference = 0 -%}
  {%- assign n_preprint = 0 -%}
  {%- assign n_patent = 0 -%}
  {%- for p in all -%}
    {%- case p.type -%}
    {%- when 'workshop' -%}{% assign n_workshop = n_workshop | plus: 1 %}
    {%- when 'poster' or 'abstract' -%}{% assign n_abstract = n_abstract | plus: 1 %}
    {%- when 'preprint' -%}{% assign n_preprint = n_preprint | plus: 1 %}
    {%- when 'patent' -%}{% assign n_patent = n_patent | plus: 1 %}
    {%- else -%}{% assign n_conference = n_conference | plus: 1 %}
    {%- endcase -%}
  {%- endfor -%}

  {%- comment -%}
    No stray whitespace inside the buttons — a newline before the label renders
    as a leading space and offsets the text inside the chip.
  {%- endcomment -%}
  <div class="pub-filters" role="group" aria-label="Filter publications by type">
    <button class="pub-filter" type="button" data-filter="all" aria-pressed="true"><span>All</span><span class="pub-filter__count">{{ all.size }}</span></button>
    <button class="pub-filter" type="button" data-filter="conference" aria-pressed="false"><span>Conference</span><span class="pub-filter__count">{{ n_conference }}</span></button>
    <button class="pub-filter" type="button" data-filter="workshop" aria-pressed="false"><span>Workshop</span><span class="pub-filter__count">{{ n_workshop }}</span></button>
    <button class="pub-filter" type="button" data-filter="abstract" aria-pressed="false"><span>Abstract</span><span class="pub-filter__count">{{ n_abstract }}</span></button>
    {%- if n_preprint > 0 %}<button class="pub-filter" type="button" data-filter="preprint" aria-pressed="false"><span>Preprint</span><span class="pub-filter__count">{{ n_preprint }}</span></button>{% endif -%}
    {%- if n_patent > 0 %}<button class="pub-filter" type="button" data-filter="patent" aria-pressed="false"><span>Patent</span><span class="pub-filter__count">{{ n_patent }}</span></button>{% endif -%}
  </div>

  {%- assign years = all | map: "year" | uniq | sort | reverse -%}
  {%- comment -%}
    data-filter mirrors the pressed chip so CSS can show the category badge
    under "All" only. The numbers in .pub__num are written by pub-filter.js:
    they count DOWN over the currently visible rows, so the newest paper always
    carries the highest number and the list ends at 1.
  {%- endcomment -%}
  <div class="pubs" id="pub-list" data-filter="all">
    {%- for y in years -%}
      <h2 class="pub-year" data-year="{{ y }}">{{ y }}</h2>
      {%- for p in pubs -%}
        {%- if p.year == y -%}{% include pub-item.liquid p=p numbered=true %}{%- endif -%}
      {%- endfor -%}
      {%- for p in patents -%}
        {%- if p.year == y -%}{% include pub-item.liquid p=p numbered=true %}{%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
  </div>
  <p class="pub-empty" hidden>No publications in this category.</p>
{%- endif -%}
