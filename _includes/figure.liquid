{%- comment -%}
  A plain <img>, used by project markdown.
  Usage: {% include figure.liquid path="assets/img/x.jpg" alt="what it shows" %}
  Sizing/rounding comes from the wrapper (.figs or .split), not from classes here.
{%- endcomment -%}
<img src="{{ include.path | relative_url }}"
     alt="{{ include.alt | default: include.title | default: '' }}"
     loading="{{ include.loading | default: 'lazy' }}">
