---
layout: default
---
<div class="page-header">
  <h1>CV</h1>
  {%- if page.cv_pdf -%}
  <div class="cv-download">
    <a class="btn" href="{{ '/assets/pdf/' | append: page.cv_pdf | relative_url }}" target="_blank" rel="noopener">
      {% include icon.liquid name="download" %} Download PDF
    </a>
  </div>
  {%- endif -%}
</div>

{%- for section in site.data.cv -%}
<section class="cv-block">
  <h2>{{ section.title }}</h2>

  {%- case section.type -%}
  {%- when 'map' -%}
    <dl class="cv-map">
      {%- for row in section.contents -%}
        <dt>{{ row.name }}</dt><dd>{{ row.value }}</dd>
      {%- endfor -%}
    </dl>

  {%- when 'time_table' -%}
    <ul class="timeline">
      {%- for row in section.contents -%}
      <li class="timeline__item">
        <p class="timeline__title">{{ row.title }}{% if row.year %} <span class="timeline__year">· {{ row.year }}</span>{% endif %}</p>
        {%- if row.institution -%}<p class="timeline__desc">{{ row.institution }}</p>{%- endif -%}
        {%- if row.description -%}
          <div class="timeline__desc">
          {%- if row.description.first -%}
            <ul>{%- for d in row.description -%}<li>{{ d }}</li>{%- endfor -%}</ul>
          {%- else -%}{{ row.description }}{%- endif -%}
          </div>
        {%- endif -%}
      </li>
      {%- endfor -%}
    </ul>

  {%- when 'nested_list' -%}
    <div class="cv-list">
    {%- for row in section.contents -%}
      <p><strong>{{ row.title }}</strong></p>
      <ul>{%- for it in row.items -%}<li>{{ it }}</li>{%- endfor -%}</ul>
    {%- endfor -%}
    </div>

  {%- else -%}{%- comment -%} list {%- endcomment -%}
    <div class="cv-list">
      <ul>{%- for it in section.contents -%}<li>{{ it }}</li>{%- endfor -%}</ul>
    </div>
  {%- endcase -%}
</section>
{%- endfor -%}
