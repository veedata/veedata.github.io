---
layout: default
---
{%- comment -%} Dormant blog article layout — kept ready for when the blog is re-enabled. {%- endcomment -%}
<article class="prose">
  <div class="article-header">
    <h1>{{ page.title }}</h1>
    <p class="meta">
      {%- if page.date %}{{ page.date | date: '%B %-d, %Y' }}{% endif -%}
      {%- if page.reading_time %} · {{ page.reading_time }}{% endif -%}
    </p>
  </div>
  {{ content }}
</article>
