---
layout: default
---
<div class="page-header">
  <h1>Projects</h1>
  <p class="lead">{{ page.description | default: 'Selected things I have built and researched.' }}</p>
</div>

{%- assign all_projects = site.projects | sort: 'importance' -%}
{%- assign groups = site.project_groups -%}
{%- assign group_keys = groups | map: 'key' -%}

{%- for g in groups -%}
  {%- assign in_group = all_projects | where: 'group', g.key -%}
  {%- if in_group.size > 0 -%}
  <section class="project-group{% if g.highlight %} project-group--featured{% endif %}">
    <div class="project-group__head">
      <h2>{{ g.name }}</h2>
      {%- if g.highlight %}<span class="badge">Current focus</span>{% endif -%}
    </div>
    {%- if g.note %}<p class="project-group__note">{{ g.note }}</p>{% endif -%}
    <div class="cards">
      {%- for project in in_group -%}
        {% include project-card.liquid project=project index=forloop.index0 %}
      {%- endfor -%}
    </div>
  </section>
  {%- endif -%}
{%- endfor -%}

{{ content }}
